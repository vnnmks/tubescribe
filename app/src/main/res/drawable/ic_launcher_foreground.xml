    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <group
        android:translateX="1.5"
        android:translateY="1.5">
        <path
            android:fillColor="#40000000"
            android:pathData="M41.5,30 L41.5,36 L81.5,54 Z M41.5,40.5 L41.5,46.5 L81.5,54 Z M41.5,51 L41.5,57 L81.5,54 Z M41.5,61.5 L41.5,67.5 L81.5,54 Z M41.5,72 L41.5,78 L81.5,54 Z" />
    </group>
    <path
        android:pathData="M41.5,30 L41.5,36 L81.5,54 Z M41.5,40.5 L41.5,46.5 L81.5,54 Z M41.5,51 L41.5,57 L81.5,54 Z M41.5,61.5 L41.5,67.5 L81.5,54 Z M41.5,72 L41.5,78 L81.5,54 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="54"
                android:startY="30"
                android:endX="54"
                android:endY="78"
                android:startColor="#FFFFFFFF"
                android:endColor="#FFE8E8E8" />
        </aapt:attr>
    </path>
</vector>
