<?xml version="1.0" encoding="utf-8"?>
<!--
  In-app brand mark, cropped to the artwork bounds of ic_launcher_foreground
  (the same five fanned play rays, without the red launcher tile), with the
  same top-down sheen. Keep the geometry in sync with the launcher foreground.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="40dp"
    android:height="48dp"
    android:viewportWidth="40"
    android:viewportHeight="48">
    <path
        android:pathData="M0,0 L0,6 L40,24 Z M0,10.5 L0,16.5 L40,24 Z M0,21 L0,27 L40,24 Z M0,31.5 L0,37.5 L40,24 Z M0,42 L0,48 L40,24 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="20"
                android:startY="0"
                android:endX="20"
                android:endY="48"
                android:startColor="#FFFFFFFF"
                android:endColor="#FFE8E8E8" />
        </aapt:attr>
    </path>
</vector>
